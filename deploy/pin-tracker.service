[Unit]
Description=Reta Tracker
After=network.target

[Service]
Type=simple
User=pintracker
WorkingDirectory=/opt/pin-tracker
Environment=PORT=3000
Environment=DATA_DIR=/opt/pin-tracker/data
ExecStart=/usr/bin/node /opt/pin-tracker/server.js
Restart=on-failure
RestartSec=2

# Basic hardening - this only serves your local LAN, but no reason to run wide open.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/pin-tracker/data

[Install]
WantedBy=multi-user.target
