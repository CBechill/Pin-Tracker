[Unit]
Description=Pin Tracker web app
After=network.target

[Service]
Type=simple
User=pintracker
WorkingDirectory=/opt/pin-tracker
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/pin-tracker
# systemd creates /var/lib/pin-tracker owned by User= and keeps it writable
# under ProtectSystem=strict - no manual mkdir/chown needed.
StateDirectory=pin-tracker
ExecStart=/usr/bin/node /opt/pin-tracker/server.js
Restart=on-failure
RestartSec=2

# Basic hardening - this only serves your local network, but no reason to run wide open.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
