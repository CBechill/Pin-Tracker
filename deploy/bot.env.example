# Pin Tracker bot config. Copy to /etc/pin-tracker/bot.env and fill in:
#   mkdir -p /etc/pin-tracker
#   cp deploy/bot.env.example /etc/pin-tracker/bot.env
#   chmod 600 /etc/pin-tracker/bot.env
# Never commit the filled-in copy or paste these values anywhere.

# From @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Leave blank at first. Message your bot once and it replies with your ID;
# paste it here and restart the bot. Only this user gets responses.
TELEGRAM_ALLOWED_USER_ID=

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Optional settings
TIME_ZONE=America/New_York
LOOKAHEAD_HOUR=8
TRACKER_URL=http://127.0.0.1:3000
BOT_CLAUDE_MODEL=claude-opus-5
BOT_CLAUDE_EFFORT=medium
